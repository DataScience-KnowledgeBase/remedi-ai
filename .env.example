# Copy to .env. Generate two DISTINCT random values using scripts\bootstrap.ps1.
OPERATOR_TOKEN=replace-with-distinct-random-operator-token
OWNER_TOKEN=replace-with-distinct-random-owner-token
PROVIDER=ollama
LOCAL_MODEL=qwen2.5:7b
OLLAMA_URL=http://ollama:11434
DATABASE_PATH=/data/remedi.db
CONFIDENCE_THRESHOLD=0.85
MAX_AGENT_STEPS=4
MAX_ACTIVE_INCIDENTS=25
REQUESTS_PER_MINUTE=120
LLM_TIMEOUT_SECONDS=90
# Configure actual energy/amortized GPU rate. Zero means UNPRICED, not free.
LOCAL_GPU_USD_PER_HOUR=0

# Alternative: OpenAI-compatible API with strict JSON-schema support.
# External egress is OFF by default. Never send sensitive data without review.
# PROVIDER=api
# ALLOW_API_EGRESS=true
# API_BASE_URL=https://api.openai.com/v1
# API_MODEL=gpt-4.1-mini
# API_KEY=replace-via-secret-manager
# INPUT_USD_PER_MILLION=0
# OUTPUT_USD_PER_MILLION=0
# Verify current provider prices; 0 means UNPRICED. Never commit this file's copy.
